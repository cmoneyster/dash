# Local development settings. Copy this file to `.env` (which git ignores)
# and fill in what you need, then run:  pnpm run dev:local
# Blank values are treated as unset.

# ── Database (required) ────────────────────────────────────────────────────
# Any PostgreSQL connection string, e.g. a Neon dev branch:
# postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ── File storage ───────────────────────────────────────────────────────────
# Leave S3_* blank to store uploads in ./.local-storage on this PC.
# For Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_DRIVER=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=

# ── Safety defaults ────────────────────────────────────────────────────────
# shadow = log texts instead of sending them. Only set to "live" on purpose.
SMS_OUTBOUND_MODE=shadow
# sandbox = Square test mode. Use Square sandbox credentials below.
SQUARE_ENVIRONMENT=sandbox

# ── Ports ──────────────────────────────────────────────────────────────────
API_PORT=8080
WEB_PORT=5173

# ── Site ───────────────────────────────────────────────────────────────────
PUBLIC_BASE_URL=http://localhost:5173
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=
EVENT_PASSWORD=
OWNER_PHONE=

# ── Square ─────────────────────────────────────────────────────────────────
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_TERMINAL_ACCESS_TOKEN=
SQUARE_TERMINAL_LOCATION_ID=

# ── SMS gateway (EJOIN) ────────────────────────────────────────────────────
EJOIN_GATEWAY_URL=
EJOIN_USER=
EJOIN_PASS=
EJOIN_ADMIN_USER=
EJOIN_ADMIN_PASS=
EJOIN_SMS_PORT=
EJOIN_GATEWAY_TZ=
EJOIN_INBOUND_MODE=
SMS_WEBHOOK_SECRET=

# ── OpenAI (menu descriptions, costing helpers) ────────────────────────────
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=

# ── Instagram ──────────────────────────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# ── Email alerts (leave blank locally to avoid sending real email) ─────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ── Google Places (venue address autocomplete) ─────────────────────────────
GOOGLE_PLACES_API_KEY=
