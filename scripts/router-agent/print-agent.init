#!/bin/sh /etc/rc.common
#
# OpenWrt init.d service for the dash Catering print agent.
#
# Install:
#   cp print-agent.init /etc/init.d/print-agent
#   chmod +x /etc/init.d/print-agent
#   /etc/init.d/print-agent enable
#   /etc/init.d/print-agent start

START=99
STOP=10
USE_PROCD=1

SCRIPT=/usr/bin/print-agent.sh
PIDFILE=/var/run/print-agent.pid

start_service() {
  procd_open_instance
  procd_set_param command "$SCRIPT"
  procd_set_param respawn 3600 5 0
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_set_param pidfile "$PIDFILE"
  procd_close_instance
}

stop_service() {
  if [ -f "$PIDFILE" ]; then
    kill "$(cat $PIDFILE)" 2>/dev/null
    rm -f "$PIDFILE"
  fi
}
